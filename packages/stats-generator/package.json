{
  "name": "@framework-performance/stats-generator",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "run:ssr-request-throughput": "node src/run-benchmarks-scripts/run-ssr-request-throughput-benchmark.ts",
    "run:ssr-load": "node src/run-benchmarks-scripts/run-ssr-load-benchmark.ts",
    "run:ssr-load:containerized": "node src/run-benchmarks-scripts/run-containerized-ssr-load.ts",
    "run:ssr-router-link-load": "SSR_LOAD_KIND=ssrLoadRouterLinks node src/run-benchmarks-scripts/run-ssr-load-benchmark.ts",
    "run:ssr-router-link-load:containerized": "SSR_LOAD_KIND=ssrLoadRouterLinks node src/run-benchmarks-scripts/run-containerized-ssr-load.ts",
    "verify:ssr-load": "node src/benchmarks/ssr-load/verify-ssr-load.ts",
    "serve:ssr-load": "node src/run-benchmarks-scripts/run-ssr-load-server.ts",
    "run:client-side-rendered": "node src/run-benchmarks-scripts/run-client-side-rendered-benchmark.ts",
    "run:server-side-rendered": "node src/run-benchmarks-scripts/run-server-side-rendered-benchmark.ts",
    "run:ssr-initial-load": "node src/run-benchmarks-scripts/run-ssr-initial-load-benchmark.ts",
    "run:ssr-initial-load-images": "node src/run-benchmarks-scripts/run-ssr-initial-load-images-benchmark.ts",
    "run:ssr-initial-load-framework-images": "node src/run-benchmarks-scripts/run-ssr-initial-load-framework-images-benchmark.ts",
    "run:install": "node src/run-benchmarks-scripts/run-install-benchmark.ts",
    "run:build": "node src/run-benchmarks-scripts/run-build-benchmark.ts",
    "run:dev-server": "node src/run-benchmarks-scripts/run-dev-server-benchmark.ts",
    "run:corejs": "node src/run-benchmarks-scripts/run-corejs-scan.ts",
    "run:browser-baseline": "node src/run-benchmarks-scripts/run-browser-baseline-scan.ts",
    "run:framework-dependencies": "node src/run-benchmarks-scripts/run-framework-dependency-scan.ts",
    "run:first-party-dependencies": "node src/run-benchmarks-scripts/run-first-party-dependency-scan.ts",
    "run:node-engines": "node src/run-benchmarks-scripts/run-node-engines-scan.ts",
    "validate:ci-stats": "node src/scripts/save-ci-stats.ts --validate-only",
    "save:ci-stats": "node src/scripts/save-ci-stats.ts",
    "validate": "node src/scripts/save-ci-stats.ts --validate-only",
    "validate:first-party-dependencies": "node src/scripts/validate-first-party-dependencies.ts",
    "sync:versions": "node src/scripts/sync-versions.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "type-check": "tsc --noEmit",
    "test": "node --test \"src/**/*.test.ts\""
  },
  "dependencies": {
    "autocannon": "^8.0.0",
    "baseline-detector": "0.4.1",
    "core-js-compat": "^3.50.0",
    "lighthouse": "^13.4.1",
    "puppeteer-core": "^25.5.0",
    "tinybench": "^6.1.2",
    "tinyglobby": "^0.2.17",
    "verkit": "^0.4.0",
    "yaml": "2.9.0",
    "zod": "catalog:",
    "@framework-performance/results": "workspace:*"
  },
  "devDependencies": {
    "@types/autocannon": "^7.12.7",
    "@types/node": "^26.1.2"
  }
}
