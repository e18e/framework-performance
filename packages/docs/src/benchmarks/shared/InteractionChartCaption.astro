---
import { INTERACTION_PHASES } from '../../lib/interaction-phases'

type InteractionPhase = (typeof INTERACTION_PHASES)[number]

interface Props {
  title?: string
  swatchColor?: (
    phase: InteractionPhase,
    index: number,
    count: number,
  ) => string
  outlined?: boolean
}

const {
  title,
  swatchColor = (phase: InteractionPhase) => phase.color,
  outlined = false,
} = Astro.props
---

<figcaption>
  {title && <p class="interaction-chart-title">{title}</p>}
  <p>
    Total latency is split into the three consecutive phases reported by
    Lighthouse.
  </p>
  <ul class="phase-descriptions">
    {
      INTERACTION_PHASES.map(({ label, description }) => (
        <li>
          The <strong>{label.toLowerCase()}</strong>, {description}
        </li>
      ))
    }
  </ul>
  <ul class="legend" aria-hidden="true">
    {
      INTERACTION_PHASES.map((phase, index) => (
        <li>
          <span
            class:list={['swatch', { outlined }]}
            style={`background: ${swatchColor(phase, index, INTERACTION_PHASES.length)}`}
          />
          {phase.label}
        </li>
      ))
    }
  </ul>
</figcaption>

<style>
  .interaction-chart-title {
    margin-bottom: 0.35rem;
    color: var(--sl-color-white);
    font-weight: 600;
    line-height: var(--sl-line-height-headings);
  }

  p {
    margin-top: 0;
    color: var(--ft-muted);
  }

  .phase-descriptions {
    margin-block: 0.5rem 1rem;
    color: var(--ft-muted);
  }

  .phase-descriptions li {
    margin-block: 0.2rem;
  }

  .legend {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem 1rem;
    margin: 1rem 0;
    padding: 0;
    color: var(--ft-muted);
    list-style: none;
  }

  .legend li {
    margin-block: 0;
    display: flex;
    align-items: center;
    gap: 0.35rem;
  }

  .swatch {
    flex-shrink: 0;
    width: 0.75rem;
    height: 0.75rem;
    border-radius: 0.2rem;
  }

  .swatch.outlined {
    border: 1px solid var(--ft-muted);
  }
</style>
