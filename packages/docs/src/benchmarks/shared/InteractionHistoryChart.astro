---
import StackedAreaChart from '../../components/StackedAreaChart.astro'
import {
  LIGHTHOUSE_INTERACTION,
  type InteractionMetric,
} from '../../lib/interaction-phases'
import type {
  InteractionHistoryDatum,
  InteractionWorkHistoryDatum,
} from '../../lib/types'
import InteractionChartCaption from './InteractionChartCaption.astro'

interface Props {
  title: string
  data: (InteractionHistoryDatum | InteractionWorkHistoryDatum)[]
  metric?: InteractionMetric
}

const { title, data, metric = LIGHTHOUSE_INTERACTION } = Astro.props
const valueOf = (datum: Props['data'][number], key: string) =>
  (datum as unknown as Record<string, number>)[key]!
---

<StackedAreaChart
  class="interaction-history-chart"
  {title}
  data={data.map((datum) => ({
    name: datum.name,
    total: valueOf(datum, metric.totalKey),
    values: Object.fromEntries(
      metric.parts.map(({ key }) => [key, valueOf(datum, key)]),
    ),
  }))}
  series={metric.parts.map(({ key, label, color }) => ({
    key,
    label,
    color,
  }))}
  valueFormat="ms"
  yAxisLabel={metric.yAxisLabel}
>
  <InteractionChartCaption slot="caption" {title} {metric} />
</StackedAreaChart>

<style>
  figure.interaction-history-chart {
    margin-block: 1.5rem 2.5rem;
  }
</style>
