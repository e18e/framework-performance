---
import BenchmarkStack from '../../components/BenchmarkStack.astro'
import type { ChartMeasurement } from '../../lib/types'
import {
  prepareSsrRequestThroughputTestsBodySizeBytesHistory,
  prepareSsrRequestThroughputTestsLatencyMsHistory,
  prepareSsrRequestThroughputTestsOpsPerSecHistory,
} from '../../lib/prepare-chart'
import VersionLineChart from '../../components/VersionLineChart.astro'

interface Props {
  versions: ChartMeasurement[]
}

const { versions } = Astro.props
---

<BenchmarkStack>
  <VersionLineChart
    {...prepareSsrRequestThroughputTestsOpsPerSecHistory(versions)}
  />
  <VersionLineChart
    {...prepareSsrRequestThroughputTestsBodySizeBytesHistory(versions)}
  />
  <VersionLineChart
    {...prepareSsrRequestThroughputTestsLatencyMsHistory(versions)}
  />
</BenchmarkStack>
