---
import BenchmarkStack from '../../components/BenchmarkStack.astro'
import type { ChartMeasurement } from '../../lib/types'
import {
  prepareLighthouseClientSideRenderedTestsFcpMsHistory,
  prepareLighthouseClientSideRenderedTestsFirstPaintMsHistory,
  prepareLighthouseClientSideRenderedTestsInteractionHistory,
  prepareClientSideRenderedInteractionWorkHistory,
} from '../../lib/prepare-chart'
import { INTERACTION_WORK } from '../../lib/interaction-phases'
import VersionLineChart from '../../components/VersionLineChart.astro'
import InteractionHistoryChart from '../shared/InteractionHistoryChart.astro'

interface Props {
  versions: ChartMeasurement[]
}

const { versions } = Astro.props

const interactionData =
  prepareLighthouseClientSideRenderedTestsInteractionHistory(versions)
const interactionWorkData =
  prepareClientSideRenderedInteractionWorkHistory(versions)
---

<BenchmarkStack>
  <VersionLineChart
    {...prepareLighthouseClientSideRenderedTestsFirstPaintMsHistory(versions)}
  />
  <VersionLineChart
    {...prepareLighthouseClientSideRenderedTestsFcpMsHistory(versions)}
  />
  {
    interactionData.length > 0 ? (
      <InteractionHistoryChart
        title="Client Interaction Breakdown by Version (Lighthouse)"
        data={interactionData}
      />
    ) : null
  }
  {
    interactionWorkData.length > 0 ? (
      <InteractionHistoryChart
        title="Client Interaction Work to Commit by Version"
        data={interactionWorkData}
        metric={INTERACTION_WORK}
      />
    ) : null
  }
</BenchmarkStack>
